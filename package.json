{
  "name": "persistence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One never-ending Pi chat with UniiChat memory and background agents, on Pi Durable",
  "bin": {
    "pi-durable": "bin/pi-durable"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "bash bin/pi-durable",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "tsc && eslint --max-warnings 0 . && bash -n bin/pi-durable",
    "typecheck": "tsc",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
