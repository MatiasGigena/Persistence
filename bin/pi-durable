#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
NODE="${PI_DURABLE_NODE:-node}"
if [[ -z "${PI_DURABLE_NODE:-}" ]] && ! "$NODE" -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=19)?0:1)' >/dev/null 2>&1; then
  if [[ -x "$HOME/.local/share/pi-node/current/bin/node" ]]; then
    NODE="$HOME/.local/share/pi-node/current/bin/node"
  else
    echo "pi-durable: Node.js >=22.19.0 is required (found: $("$NODE" --version 2>/dev/null || echo none)); install it, or set PI_DURABLE_NODE" >&2
    exit 1
  fi
fi
exec "$NODE" "$ROOT/src/cli.ts" "$@"
